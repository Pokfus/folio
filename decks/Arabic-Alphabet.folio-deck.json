ng=\"ar\">حَلِيب</span><span class=\"uc-exe\">milk</span>", "Word": "حَلِيب"}, "id": "u_arabc_6", "type": "ar-abc"}, {"sub": "", "fields": {"Letter": "خ", "Shapes": "<div class=\"uc-shapes\" dir=\"rtl\"><span class=\"uc-sh\"><span class=\"uc-shf\" lang=\"ar\">خ</span><span class=\"uc-shl\" dir=\"ltr\">alone</span></span><span class=\"uc-sh\"><span class=\"uc-shf\" lang=\"ar\">خـ</span><span class=\"uc-shl\" dir=\"ltr\">start</span></span><span class=\"uc-sh\"><span class=\"uc-shf\" lang=\"ar\">ـخـ</span><span class=\"uc-shl\" dir=\"ltr\">middle</span></span><span class=\"uc-sh\"><span class=\"uc-shf\" lang=\"ar\">ـخ</span><span class=\"uc-shl\" dir=\"ltr\">end</span></span></div>", "Name": "خَاء", "Roman": "ḵāʔ — ḵ", "Sound": "&quot;ch&quot; as in Scottish loch or German Bach", "Example": "<span class=\"uc-ex\" dir=\"rtl\" lang=\"ar\">خُبْز</span><span class=\"uc-exe\">bread</span>", "Word": "خُبْز"}, "id": "u_arabc_7", "type": "ar-abc"}, {"sub": "", "fields": {"Letter": "د", "Shapes": "<div class=\"uc-shapes\" dir=\"rtl\"><span class=\"uc-sh\"><span class=\"uc-shf\" lang=\"ar\">د</span><span class=\"uc-shl\" dir=\"ltr\">alone</span></span><span class=\"uc-sh\"><span class=\"uc-shf\" lang=\"ar\">د</span><span class=\"uc-shl\" dir=\"ltr\">start</span></span><span class=\"uc-sh\"><span class=\"uc-shf\" lang=\"ar\">ـد</span><span class=\"uc-shl\" dir=\"ltr\">middle</span></span><span class=\"uc-sh\"><span class=\"uc-shf\" lang=\"ar\">ـد</span><span class=\"uc-shl\" dir=\"ltr\">end</span></span></div>", "Name": "دَال", "Roman": "dāl — d", "Sound": "&quot;d&quot; as in dog; it never joins to the letter after it", "Example": "<span class=\"uc-ex\" dir=\"rtl\" lang=\"ar\">دَرْس</span><span class=\"uc-exe\">lesson</span>", "Word": "دَرْس"}, "id": "u_arabc_8", "type": "ar-abc"}, {"sub": "", "fields": {"Letter": "ذ", "Shapes": "<div class=\"uc-shapes\" dir=\"rtl\"><span class=\"uc-sh\"><span class=\"uc-shf\" lang=\"ar\">ذ</span><span class=\"uc-shl\" dir=\"ltr\">alone</span><