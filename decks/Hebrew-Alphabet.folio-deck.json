apes": "<div class=\"uc-sl\">lamed</div>", "Sound": "<span class=\"uc-rm\">l</span> · &quot;l&quot; as in leaf", "Clue": "<span class=\"uc-rm\">lékhem</span><span class=\"uc-exe\">bread</span>", "Example": "<span class=\"uc-ex\" dir=\"rtl\" lang=\"he\">לֶחֶם</span><span class=\"uc-exr\">lékhem</span><span class=\"uc-exe\">bread</span>", "Word": "לחם"}, "id": "u_heabc_14", "type": "he-abc"}, {"sub": "", "fields": {"Letter": "<span dir=\"rtl\" lang=\"he\">מ</span>", "Name": "מֵם", "Shapes": "<div class=\"uc-sl\">mem</div><div class=\"uc-fin\"><span class=\"uc-sl\">at the end of a word</span><span class=\"uc-sf\" dir=\"rtl\" lang=\"he\">ם</span></div>", "Sound": "<span class=\"uc-rm\">m</span> · &quot;m&quot; as in man", "Clue": "<span class=\"uc-rm\">máyim</span><span class=\"uc-exe\">water</span>", "Example": "<span class=\"uc-ex\" dir=\"rtl\" lang=\"he\">מַיִם</span><span class=\"uc-exr\">máyim</span><span class=\"uc-exe\">water</span>", "Word": "מים"}, "id": "u_heabc_15", "type": "he-abc"}, {"sub": "", "fields": {"Letter": "<span dir=\"rtl\" lang=\"he\">נ</span>", "Name": "נוּן", "Shapes": "<div class=\"uc-sl\">nun</div><div class=\"uc-fin\"><span class=\"uc-sl\">at the end of a word</span><span class=\"uc-sf\" dir=\"rtl\" lang=\"he\">ן</span></div>", "Sound": "<span class=\"uc-rm\">n</span> · &quot;n&quot; as in no", "Clue": "<span class=\"uc-rm\">nakhón</span><span class=\"uc-exe\">right, correct</span>", "Example": "<span class=\"uc-ex\" dir=\"rtl\" lang=\"he\">נָכוֹן</span><span class=\"uc-exr\">nakhón</span><span class=\"uc-exe\">right, correct</span>", "Word": "נכון"}, "id": "u_heabc_16", "type": "he-abc"}, {"sub": "", "fields": {"Letter": "<span dir=\"rtl\" lang=\"he\">ס</span>", "Name": "סָמֶךְ", "Shapes": "<div class=\"uc-sl\">samekh</div>", "Sound": "<span class=\"uc-rm\">s</span> · &quot;s&quot; as in sun — the everyday s; said exactly as שׂ", "Clue": "<span class=\"uc-rm\">séfer</span><span class=\"uc-exe\">book</span>", "Example": "<span class=\"uc-ex\