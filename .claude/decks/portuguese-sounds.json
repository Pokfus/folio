"vowels": [
 {"key":"vowel:final","show":"-a · -e · -o","name":"the unstressed endings","says":"Monosyllables ending in <i>-o(s)</i> with the vowel pronounced /u/ (as in English \"do\") or in <i>-e(s)</i> with the vowel pronounced /i/ (as in English \"be\") or /ɨ/ (approximately as in English \"roses\") are not accented. […] The endings <i>-a(s)</i>, <i>-e(s)</i>, <i>-o(s)</i>, <i>-am</i>, <i>-em</i>, <i>-ens</i> are unstressed.","rows":[{"when":"-a","ipa":"/ɐ/","like":"<b>a</b>bout","rx":"(?<=[^aeiouáéíóúâêôãõ])a$"},{"when":"-e","ipa":"/ɨ/","like":"EP: <b>e</b>mission","rx":"(?<=[^aeiouáéíóúâêôãõ])e$"},{"when":"-o","ipa":"/u/","like":"outl<b>oo</b>k","rx":"(?<=[^aeiouáéíóúâêôãõ])o$"}]},
 {"key":"vowel:ou-ei","show":"ou · ei","name":"two diphthongs","says":"The pronunciation of each diphthong is also fairly predictable […].","rows":[{"when":"ou","ipa":"[ou ~ oː]","like":"EP: st<b>o</b>ry","rx":"ou"},{"when":"ei, êi","ipa":"[ei ~ e(ː)], [əi] (In central Portugal.)","rx":"ei"}]},
 {"key":"nasal:ã","show":"ã","name":"the tilde","says":"The <b>tilde</b> (◌̃) marks nasal vowels before glides such as in <i>cãibra</i> and <i>nação</i>, at the end of words, before final <i>-s</i>, and in some compounds […].","rows":[{"when":"","ipa":"/ɐ̃/","rx":"ã(?![oei])"}]},
 {"key":"nasal:ão","show":"ão · ãe","name":"the nasal diphthongs","says":"The form <i>õ</i> is used only in the plurals of nouns ending in <i>-ão</i> (<i>nação → nações</i>) and in the second person singular and third person forms of the verb <i>pôr</i> in the present tense (<i>pões, põe, põem</i>).","rows":[{"when":"ão","ipa":"[ɐ̃ũ]","rx":"ão"},{"when":"ãe, ãi","ipa":"[ɐ̃ĩ]","rx":"ãe|ãi"},{"when":"õe","ipa":"[õĩ]","rx":"õe"}]},
 {"key":"nasal:m-n","show":"-m · -n","name":"m or n at the end of a syllable","says":"When a syllable ends with ⟨m⟩ or ⟨n⟩, the consonant is not fully pronounced but merely indicates the nasalization of the vowel which precedes it. At the end of words, it generally produces a nasal diphthong.","rows":[{"when":"-an, -am, -ân, -âm […] at the end of a syllable","ipa":"/ɐ̃/","rx":"[aâ]n(?=[^aeiouáéíóúh])|[aâ]m(?=[pb])"},{"when":"-em, -êm, -ém […] at the end of a word","ipa":"/ẽĩ/ ([ɐ̃ĩ])","rx":"[eéê]m$"},{"when":"-in, -im, -ín, -ím […] at the end of a syllable or word","ipa":"/ĩ/","rx":"[ií]m$|[ií]n(?=[^aeiouáéíóúh])|[ií]m(?=[pb])"},{"when":"-on, -om, -ôn, -ôm […] at the end of a syllable or word","ipa":"/õ/","rx":"[oô]m$|[oô]n(?=[^aeiouáéíóúh])|[oô]m(?=[pb])"},{"when":"-un, -um, -ún, -úm […] at the end of a syllable or word","ipa":"/ũ/","rx":"[uú]m$|[uú]n(?=[^aeiouáéíóúh])|[uú]m(?=[pb])"}]}
],
