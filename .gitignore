# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# just in case tooling ever gets installed locally — the site itself has zero dependencies
node_modules/
*.log

# Claude Code machine-local settings
.claude/settings.local.json

# build-time TTS toolchain + voice models (fetched by .claude/build-tts.js; ~150 MB, never shipped)
.claude/tts-cache/

# per-chapter scratch for .claude/fetch-book.js, so a re-run costs no refetch. The generated
# books/<id>.js IS committed — this is only the working cache behind it.
.claude/book-cache/

# Commons image-candidate cache for .claude/fetch-images.js. The chosen pictures ARE committed
# (into data.js / glossary.js) — this is only the working list of what was looked at.
.claude/image-cache/

# the working files behind .claude/gen-artefact-art.js: the cached Commons reference photos it
# restyles from, the raw provider output, and the review contact sheet. The generated art in
# art/artefacts/ IS committed, and so is artefact-art/manifest.json — that manifest is the record
# of how each piece was made, without which no piece can be regenerated to match its neighbours.
.claude/artefact-art/ref/
.claude/artefact-art/raw/
.claude/artefact-art/sheet.html

# the four corpora .claude/dele/run.py builds the Spanish decks from (~1.2 GB, the
# Wiktionary dump being most of it), plus the intermediate files between its stages.
# The deck it writes IS committed — this is only the working cache behind it.
.claude/dele-cache/
# run.py imports one stage from another, so Python leaves bytecode beside them
__pycache__/
